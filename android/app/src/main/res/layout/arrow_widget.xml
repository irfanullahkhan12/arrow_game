<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget: a level badge and progress on top, the live board in
  the middle, and the controls underneath. Everything is tappable — the board
  itself plays a move without opening the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Header: level badge on the left, arrows-left on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_level_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FF4D9D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="LEVEL 1" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:textColor="#D9A6C4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Arrow Escape" />
    </LinearLayout>

    <!-- The live board -->
    <ImageView
        android:id="@+id/widget_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_board_description" />

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_button"
            android:text="@string/widget_play"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FF4D9D" />

        <TextView
            android:id="@+id/widget_new"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_button"
            android:text="↻"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF9AD5" />

        <TextView
            android:id="@+id/widget_open"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_button"
            android:text="⛶"
            android:textSize="15sp"
            android:textColor="#FFD54A" />
    </LinearLayout>
</LinearLayout>
